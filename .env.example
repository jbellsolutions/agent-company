# ── LLM Providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=              # Meta-Orchestrator (Opus 4.7) + CEOs + Leads (Sonnet 4.6)
OPENROUTER_API_KEY=             # Workers via DeepSeek V4 Flash (~10x cheaper)

# ── Tool Integrations ──────────────────────────────────────────────────────────
COMPOSIO_API_KEY=               # 1000+ SaaS integrations (Apollo, Gmail, LinkedIn, etc.)

# ── Slack Interface ────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=                # Bot token (xoxb-...)
SLACK_SIGNING_SECRET=           # From Slack app settings
SLACK_APP_TOKEN=                # For Socket Mode (xapp-...)

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=                   # Postgres URL (Railway auto-injects: postgresql://...)

# ── Company Config ─────────────────────────────────────────────────────────────
PRIMARY_COMPANY_NAME=           # e.g. "Using AI to Scale"
PRIMARY_COMPANY_CONTEXT=        # One-paragraph description of your business + ICP
